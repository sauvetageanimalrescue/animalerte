# Supabase — copiez ce fichier vers .env.local et remplissez les valeurs.
# Tableau de bord Supabase → Project Settings → API

# URL du projet (ex. https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clé publiable (« publishable » / anon) — exposée au navigateur, sans danger.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé service_role — SECRÈTE, côté serveur uniquement. Ne jamais exposer.
SUPABASE_SERVICE_ROLE_KEY=
