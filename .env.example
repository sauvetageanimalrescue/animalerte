# Supabase — copiez ce fichier vers .env.local et remplissez les valeurs.
# Tableau de bord Supabase → Project Settings → API

# URL du projet (ex. https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clé publiable (« publishable » / anon) — exposée au navigateur, sans danger.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé service_role — SECRÈTE, côté serveur uniquement. Ne jamais exposer.
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps / Places — recherche d'adresse. Clé restreinte par référent HTTP.
# À définir aussi dans les variables d'environnement Vercel.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Resend — envoi du formulaire de contact. Clé API (re_...), côté serveur.
# À créer dans Resend → API Keys, puis à définir aussi sur Vercel.
RESEND_API_KEY=

# Adresse qui reçoit les messages du formulaire de contact.
CONTACT_EMAIL=e.dussault@sar.quebec
